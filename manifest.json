{
  "manifest_version": 3,
  "name": "leaf-tab",
  "version": "1.0.0",
  "description": "A basic Edge extension skeleton.",
  "author": "EggFine",
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "leaf-tab"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}